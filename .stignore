// Ignorar estado de ventanas de Obsidian (no se sincronizan entre dispositivos)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/workspace.json.bak
.obsidian/workspace-mobile.json.bak

// Cachés de Obsidian
.obsidian/cache
.obsidian/.trash
.obsidian/plugins/*/data.json.bak

// Papelera y temporales
.trash
.tmp
*.tmp
~$*
.DS_Store
Thumbs.db
Desktop.ini

// Respaldos de sync conflict de workspace
.obsidian/workspace*.json
.obsidian/workspace-mobile*.json
// Smart Connections: DB local por dispositivo, no sincronizar
.smart-env

// Plugins: lista por dispositivo (el movil la vaciaba y apagaba plugins en PC)
.obsidian/community-plugins.json

// Estado UI por dispositivo (el movil lo sobrescribia: conflictos 2026-10-11)
.obsidian/app.json
.obsidian/appearance.json
.obsidian/core-plugins.json
.obsidian/graph.json
